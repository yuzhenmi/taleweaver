{
  "name": "@taleweaver/pdf",
  "version": "0.1.0",
  "description": "PDF export for Taleweaver print layouts.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzhenmi/taleweaver.git",
    "directory": "packages/pdf"
  },
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@taleweaver/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/integration",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "rm -rf dist",
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --packages=external --format=esm --target=es2022 --sourcemap --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE"
  },
  "dependencies": {
    "@taleweaver/core": "^0.1.0",
    "@taleweaver/print": "^0.1.0"
  },
  "devDependencies": {
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
