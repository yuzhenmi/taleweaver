{
  "name": "@taleweaver/print",
  "version": "0.1.0",
  "description": "Paginated layout engine and canvas editing host for Taleweaver.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuzhenmi/taleweaver.git",
    "directory": "packages/print"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "@taleweaver/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/integration",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "rm -rf dist",
    "build": "tsc --emitDeclarationOnly && esbuild src/index.ts --bundle --packages=external --format=esm --target=es2022 --sourcemap --outfile=dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "cp ../../LICENSE LICENSE",
    "postpack": "rm -f LICENSE"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@taleweaver/core": "^0.1.0",
    "yjs": "13.6.30"
  },
  "devDependencies": {
    "@taleweaver/hyphenation-en-us": "^0.1.0",
    "typescript": "^5.7",
    "vitest": "^3",
    "yjs": "13.6.30"
  }
}
